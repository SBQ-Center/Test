---
import{site}from'../../config/site';import{getUI}from'../../i18n/translations';import SocialLinks from'../social/SocialLinks.astro';

type Locale = 'ar' | 'en';
const { locale = 'ar' } = Astro.props as { locale?: Locale };
const t = getUI(locale);
---
<section class="section section--soft" aria-labelledby={`contact-${locale}`}>
  <div class="container contact-grid">
    <aside class="contact-panel">
      <h2 id={`contact-${locale}`}>{t.contact}</h2>
      <p>{t.intro}</p>
      <ul class="contact-list">
        <li><span class="contact-label">{t.address}</span><address>{site.address[locale]}</address></li>
        {site.email && <li><span class="contact-label">{t.email}</span><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {site.phone && <li><span class="contact-label">{t.phone}</span><a href={`tel:${site.phone}`}>{site.phone}</a></li>}
      </ul>
      <SocialLinks locale={locale} />
    </aside>
    <form class="form" onsubmit="return false" aria-describedby={`notice-${locale}`}>
      <div class="form-grid">
        <div class="field"><label for={`name-${locale}`}>{t.fullName}</label><input id={`name-${locale}`} name="name" autocomplete="name" required/></div>
        <div class="field"><label for={`email-${locale}`}>{t.email}</label><input id={`email-${locale}`} name="email" type="email" autocomplete="email" required/></div>
        <div class="field full"><label for={`subject-${locale}`}>{t.subject}</label><input id={`subject-${locale}`} name="subject" required/></div>
        <div class="field full"><label for={`message-${locale}`}>{t.message}</label><textarea id={`message-${locale}`} name="message" minlength="20" required></textarea></div>
      </div>
      <p class="form-status" id={`notice-${locale}`} role="status">{t.notice}</p>
      <button class="btn btn--navy" type="submit" disabled>{t.inactive}</button>
    </form>
  </div>
</section>
