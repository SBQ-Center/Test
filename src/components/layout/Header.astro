---
import{site}from'../../config/site';import{navigation}from'../../config/navigation';import{localizedPath}from'../../utils/locale';import{getUI}from'../../i18n/translations';

type Locale = 'ar' | 'en';
const { locale = 'ar' } = Astro.props as { locale?: Locale };
const t = getUI(locale);
const languageUrl = localizedPath(Astro.url.pathname, locale);
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href={locale === 'ar' ? '/' : '/en/'}>
      <img src={site.logo} alt={site.name[locale]} width="560" height="160" 
        srcset="/brand/logo.svg 1200w" sizes="(max-width:600px) 320px, (max-width:1024px) 560px, 1200px"/>
    </a>
    <nav class="nav" aria-label={t.nav}>
      <ul class="nav-list" id="primary-nav" data-open="false">
        {navigation[locale].map((pair: readonly [string, string]) => {
          const [label, href] = pair;
          return <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>;
        })}
      </ul>
      <a class="lang" href={languageUrl} lang={locale === 'ar' ? 'en' : 'ar'}>{t.alternate}</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.open} data-open-label={t.open} data-close-label={t.close}><span aria-hidden="true">☰</span></button>
    </nav>
  </div>
</header>
<script is:inline>
const b = document.querySelector('.menu-button');
const m = document.querySelector('#primary-nav');
if (b && m) {
  const close = () => {
    m.dataset.open = 'false';
    b.setAttribute('aria-expanded', 'false');
    const openLabel = (b.dataset && b.dataset.openLabel) ? b.dataset.openLabel : '';
    b.setAttribute('aria-label', openLabel || '');
    const span = b.querySelector('span');
    if (span) span.textContent = '☰';
  };

  b.addEventListener('click', () => {
    const o = m.dataset.open !== 'true';
    m.dataset.open = String(o);
    b.setAttribute('aria-expanded', String(o));
    const label = o ? ((b.dataset && b.dataset.closeLabel) ? b.dataset.closeLabel : '') : ((b.dataset && b.dataset.openLabel) ? b.dataset.openLabel : '');
    b.setAttribute('aria-label', label || '');
    const span = b.querySelector('span');
    if (span) span.textContent = o ? '×' : '☰';
  });

  m.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', close); });

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { close(); if (typeof b.focus === 'function') b.focus(); } });
}
</script>
