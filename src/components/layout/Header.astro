---
import{site}from'../../config/site';import{navigation}from'../../config/navigation';import{localizedPath}from'../../utils/locale';import{getUI}from'../../i18n/translations';

type Locale = 'ar' | 'en';
const { locale = 'ar' } = Astro.props as { locale?: Locale };
const t = getUI(locale);
const languageUrl = localizedPath(Astro.url.pathname, locale);
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-row">
    <a class="brand" href={locale === 'ar' ? '/' : '/en/'}>
      <img src={site.logo} alt={site.name[locale]} width="560" height="160"/>
    </a>
    <nav class="nav" aria-label={t.nav}>
      <ul class="nav-list" id="primary-nav" data-open="false">
        {navigation[locale].map(([label, href]: [string, string], i: number) =>
          <li key={i}><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
        )}
      </ul>
      <a class="lang" href={languageUrl} lang={locale === 'ar' ? 'en' : 'ar'}>{t.alternate}</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.open} data-open-label={t.open} data-close-label={t.close}><span aria-hidden="true">☰</span></button>
    </nav>
  </div>
</header>
<script is:inline>
const b = document.querySelector('.menu-button'), m = document.querySelector('#primary-nav');
if (b && m) {
  const close = () => { m.dataset.open = 'false'; (b as any).ariaExpanded = 'false'; (b as any).ariaLabel = (b as any).dataset.openLabel; b.querySelector('span')!.textContent = '☰' };
  b.addEventListener('click', () => { const o = m.dataset.open !== 'true'; m.dataset.open = String(o); (b as any).ariaExpanded = String(o); (b as any).ariaLabel = o ? (b as any).dataset.closeLabel : (b as any).dataset.openLabel; b.querySelector('span')!.textContent = o ? '×' : '☰' });
  m.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
  document.addEventListener('keydown', e => { if ((e as KeyboardEvent).key === 'Escape') { close(); b.focus() } });
}
</script>
