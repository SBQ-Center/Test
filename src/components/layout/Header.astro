---
import{site}from'../../config/site';import{navigation}from'../../config/navigation';import{localizedPath}from'../../utils/locale';import{getUI}from'../../i18n/translations';const{locale='ar'}=Astro.props;const t=getUI(locale),path=Astro.url.pathname,languageUrl=localizedPath(path,locale==='ar'?'en':'ar');
---
<header class="site-header"><div class="container header-row"><a class="brand" href={locale==='ar'?'/':'/en/'}><img src={site.logo} alt={site.name[locale]} width="560" height="160"/></a><nav class="nav" aria-label={t.nav}><ul class="nav-list" id="primary-nav" data-open="false">{navigation[locale].map(([label,href])=><li><a href={href} aria-current={path===href?'page':undefined}>{label}</a></li>)}</ul><a class="lang" href={languageUrl} lang={locale==='ar'?'en':'ar'}>{t.alternate}</a><button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={t.open} data-open-label={t.open} data-close-label={t.close}><span aria-hidden="true">☰</span></button></nav></div></header><script is:inline>const b=document.querySelector('.menu-button'),m=document.querySelector('#primary-nav');if(b&&m){const close=()=>{m.dataset.open='false';b.ariaExpanded='false';b.ariaLabel=b.dataset.openLabel;b.querySelector('span').textContent='☰'};b.addEventListener('click',()=>{const o=m.dataset.open!=='true';m.dataset.open=String(o);b.ariaExpanded=String(o);b.ariaLabel=o?b.dataset.closeLabel:b.dataset.openLabel;b.querySelector('span').textContent=o?'×':'☰'});m.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();b.focus()}})}</script>
