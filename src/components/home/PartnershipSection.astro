---
import{home}from'../../data/home';

type Locale = 'ar' | 'en';
const { locale = 'ar' } = Astro.props as { locale?: Locale };
const [title, text, button] = home[locale].cta as [string, string, string];
---
<section class="section">
  <div class="container">
    <div class="cta">
      <h2>{title}</h2>
      <p>{text}</p>
      <a class="btn btn--gold" href={locale === 'ar' ? '/contact/' : '/en/contact/'}>{button}</a>
    </div>
  </div>
</section>
